.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# The Lake project and its packages are built locally by `hardy setup`,
# never committed: they are hundreds of megabytes of compiled Mathlib.
lean_project/

# Linked worktrees live inside the repo for convenience; their contents
# belong to their own branches, never to this checkout.
.worktrees/
.claude/worktrees/

# Scratch for plan execution: ledgers, task briefs, review packages. The git
# history is the durable record, not this.
.superpowers/

# A project Hardy creates in this checkout keeps its build tree and its
# machine-local state out of git; its sources, writeup and record beside them
# are versioned, and each project carries its own .gitignore saying so. Only
# this checkout's own .hardy/.build/ belongs here: a project-wide */.build/
# or */.local/ would hide those names under every top-level directory, not
# only Hardy's own projects, silently dropping unrelated files from `git
# status`.
.hardy/.build/

# Built distributions. The release workflow builds them into dist/ and the
# installer workflow into release/; both belong to a run, not to the checkout.
dist/
release/

# Coverage output. `pyproject.toml` configures it and CI keeps the report as
# an artifact; the numbers belong to a run, not to the checkout.
.coverage
.coverage.*
coverage.xml
htmlcov/

# The default `hardy batch --output` destination. Generated experiment data,
# and the one place an ordinary run from a checkout writes to: tracked, every
# run dirties the worktree and invites a commit of model output.
hardy-output/

# Scoreboards and their run directories: model output again, and large. Rooted
# with a leading slash so this is the top-level output directory only -- bare
# `evals/` matches at any depth and silently swallows `src/hardy/evals/`, whose
# already-tracked files keep working while any file added there goes unnoticed.
# `evals/baseline.json` stays tracked (ignoring a tracked path does not untrack
# it); it is regenerable with `hardy evals baseline --status active`.
/evals/
