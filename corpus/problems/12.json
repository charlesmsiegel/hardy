    {
      "id": "la-real-quadratic-factors-iff-discriminant",
      "input": "Let $\\alpha, \\beta \\in \\mathbb{R}$. The polynomial $x^2 + \\alpha x + \\beta$ factors as $(x - \\lambda_1)(x - \\lambda_2)$ with $\\lambda_1, \\lambda_2 \\in \\mathbb{R}$ if and only if $\\alpha^2 \\ge 4\\beta$.",
      "name": "RealQuadraticFactorsIffDiscriminant",
      "binders": "(α β : ℝ)",
      "conclusion": "(∃ l₁ l₂ : ℝ, Polynomial.X ^ 2 + Polynomial.C α * Polynomial.X + Polynomial.C β = (Polynomial.X - Polynomial.C l₁) * (Polynomial.X - Polynomial.C l₂)) ↔ 4 * β ≤ α ^ 2",
      "imports": [
        "Mathlib"
      ],
