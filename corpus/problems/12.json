      "binders": "(p : Polynomial ℂ) (hp : 0 < p.natDegree)",
      "conclusion": "p.roots.toFinset.card = p.natDegree ↔ ∀ z, p.eval z = 0 → (Polynomial.derivative p).eval z ≠ 0",
