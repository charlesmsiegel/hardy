      "id": "la-lagrange-interpolation",
      "input": "Let $K$ be a field, $z_1, \\dots, z_{m+1}$ distinct elements of $K$ and $w_1, \\dots, w_{m+1} \\in K$. Then there is exactly one polynomial $p$ over $K$ of degree at most $m$ with $p(z_j) = w_j$ for every $j$.",
      "name": "LagrangeInterpolation",
      "binders": "{K : Type*} [Field K] {m : ℕ} (z w : Fin (m + 1) → K) (hz : Function.Injective z)",
      "conclusion": "∃! p : Polynomial K, p.degree ≤ m ∧ ∀ j, p.eval (z j) = w j",
