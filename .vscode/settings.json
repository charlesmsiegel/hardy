{
  // The shared Mathlib project lives in the per-user data directory, never in
  // this checkout, but a Lake project anywhere under the workspace clones each
  // dependency as a standalone git repo. Without these, VS Code would discover
  // every package clone as an extra source-control root.
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".lake"
  ],
  // The user-level setting is -1 (unlimited). This repo has no legitimate
  // nested repositories, so cap the scan at the root. Linked worktrees are
  // found via .git/worktrees by `git.detectWorktrees` and are not affected by
  // scan depth.
  "git.repositoryScanMaxDepth": 1
}
